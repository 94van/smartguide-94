page{background:#f3f6fa;color:#243d5b;font-family:Arial,sans-serif;font-size:28rpx}button{font-size:28rpx;border-radius:14rpx;margin-top:16rpx}button::after{border:0}.primary{background:#276bee;color:white}.secondary{background:#eaf1ff;color:#3975cc}.card{background:white;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx}.title{font-size:36rpx;font-weight:bold;margin-bottom:14rpx}.muted{color:#8a9bb0;font-size:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.pad{padding:28rpx}.small{font-size:24rpx}input{background:#f0f4fa;padding:18rpx;border-radius:10rpx;margin:15rpx 0}.tag{color:#3675d0;background:#eaf2ff;border-radius:8rpx;padding:6rpx 12rpx;font-size:22rpx}.step{padding:20rpx 0;border-bottom:1px solid #edf1f5}.step.current{color:#276bee;font-weight:bold}.step.done{color:#74a393}.map{background:#14253c;border-radius:16rpx;overflow:hidden;margin:20rpx 0}.map canvas{width:100%;height:580rpx}.warning{color:#a8772b;background:#fff3dc;padding:16rpx;margin-bottom:20rpx;border-radius:12rpx}.hint{color:#788da8;font-size:26rpx;line-height:1.8;margin:14rpx 0}.big .hint,.big .step{font-size:34rpx}
